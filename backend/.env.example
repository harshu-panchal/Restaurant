NODE_ENV=development
PORT=5000

MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=rws_token

CLIENT_URL=http://localhost:5173

# File storage: "local" or "cloudinary"
STORAGE_PROVIDER=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Business contact info (also editable via Admin > Settings once seeded)
BUSINESS_WHATSAPP_NUMBER=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# Initial admin user (used only by the seed script)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
